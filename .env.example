PUBLIC_COMPANY_NAME=
PUBLIC_DOMAIN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Content pipeline (`pnpm content:fetch`). Set one of these; with neither set the
# committed content/linkedin.json is used as-is.
#
# Path to the LinkedIn data export ZIP (or the unzipped folder, or an https URL).
LINKEDIN_EXPORT=
# Bearer token sent when LINKEDIN_EXPORT is a URL (e.g. the linkedin-sync worker).
LINKEDIN_EXPORT_TOKEN=
# DMA Member Data Portability token (only issued to EEA / Swiss accounts).
LINKEDIN_DMA_TOKEN=

# One-time `pnpm content:migrate-sanity`
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_TOKEN=
