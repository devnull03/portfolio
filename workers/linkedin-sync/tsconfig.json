{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
